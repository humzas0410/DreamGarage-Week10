@model List<Car>
@{
    ViewData["Title"] = "The Garage";
}
<header>
<div class="text-center">
    <h2 class="display-2">The DreamGarage</h2>
    <h6><em>Welcome to The DreamGarage! The best place to find your dream cars.</em></h6>
</div>
</header>

<a href="/Garage/Create" class="btn btn-primary mb-3">Add a Car</a>
<a href="/Garage/AddReview" class="btn btn-success mb-3">Add a Review</a>

<div class="row row-cols-1 row-cols-md-3 g-4 justify-content-center">
    @if (Model.Any())
    {
        @foreach (var car in Model)
        {
            <div class="col">
                <partial name="_CarCard" model="car" />
            </div>
        }
    }
    else {
        <div class="text-center mt-5">
            <p class="text-center">No cars found in the garage. Add cars to see them here.</p>
            <a href="/Garage/Create" class="btn btn-primary">Add a Car</a>
        </div>
    }
</div>
@section Scripts {
    <script src="https://jgrissom.github.io/dotnet-web-dev/week-10/homework-checks.js"></script>
}