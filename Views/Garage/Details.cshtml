@model Car
@{
    ViewData["Title"] = Model.Make + " " + Model.Model;
}

<h1 class="display-3 text-center">@Model.Make @Model.Model @Model.Trim</h1>
<div class="container text-center">
    <div class="d-none d-md-block">
    <table class="table table-striped">
    <thead>
    <tr>
        <th>Make</th>
        <th>Model</th>
        <th>Trim</th>
        <th>Year</th>
        <th>Color</th>
        <th>Price</th>
        <th>Horsepower</th>
        <th>Electric?</th>
        <th>Hybrid?</th>
        <th>Drivetrain</th>
    </tr>
    </thead>
    <tbody>
        <tr>
            <td>@Model.Make</td>
            <td>@Model.Model</td>
            <td>@Model.Trim</td>
            <td>@Model.Year</td>
            <td>@Model.Color</td>
            <td>@Model.Price.ToString("C0", System.Globalization.CultureInfo.GetCultureInfo("en-US"))</td>
            <td>@Model.Horsepower</td>
            <td>
                @if (Model.IsElectric)
                {
                    <span class="badge badge-pill bg-primary">Yes</span>
                }
                else
                {
                    <span class="badge badge-pill bg-warning">No</span>
                }
            </td>
            <td>
                @if (Model.IsHybrid)
                {
                    <span class="badge bg-primary">Yes</span>
                }
                else
                {
                    <span class="badge bg-warning">No</span>
                }
            </td>
            <td>@(Model.Drivetrain ?? "Not specified")</td>
        </tr>
    </tbody>
</table>
    </div>
    @* Mobile view / Label & Value Pairs *@
    <dl class="d-md-none text-start mx-auto" style="max-width: 300px;">
        <div class="row py-2 border-bottom">
            <dt class="col-5 mb-0">Make</dt>
            <dd class="col-7 mb-0 text-end">@Model.Make</dd>
        </div>
        <div class="row py-2 border-bottom">
            <dt class="col-5 mb-0">Model</dt>
            <dd class="col-7 mb-0 text-end">@Model.Model</dd>
        </div>
        <div class="row py-2 border-bottom">
            <dt class="col-5 mb-0">Trim</dt>
            <dd class="col-7 mb-0 text-end">@Model.Trim</dd>
        </div>
        <div class="row py-2 border-bottom">
            <dt class="col-5 mb-0">Year</dt>
            <dd class="col-7 mb-0 text-end">@Model.Year</dd>
        </div>
        <div class="row py-2 border-bottom">
            <dt class="col-5 mb-0">Color</dt>
            <dd class="col-7 mb-0 text-end">@Model.Color</dd>
        </div>
        <div class="row py-2 border-bottom">
            <dt class="col-5 mb-0">Price</dt>
            <dd class="col-7 mb-0 text-end">@Model.Price.ToString("C0", System.Globalization.CultureInfo.GetCultureInfo("en-US"))</dd>
        </div>
        <div class="row py-2 border-bottom">
            <dt class="col-5 mb-0">Horsepower</dt>
            <dd class="col-7 mb-0 text-end">@Model.Horsepower</dd>
        </div>
        <div class="row py-2 border-bottom">
            <dt class="col-5 mb-0">Electric?</dt>
            <dd class="col-7 mb-0 text-end">@(Model.IsElectric)</dd>
        </div>
        <div class="row py-2 border-bottom">
            <dt class="col-5 mb-0">Hybrid?</dt>
            <dd class="col-7 mb-0 text-end">@(Model.IsHybrid)</dd>
        </div>
        <div class="row py-2 border-bottom">
            <dt class="col-5 mb-0">Drivetrain</dt>
            <dd class="col-7 mb-0 text-end">@(Model.Drivetrain)</dd>
        </div>
    </dl>
    @if (!string.IsNullOrEmpty(Model.ImageUrl))
    {
        <img src="@Model.ImageUrl"
             alt="@Model.Make @Model.Model @Model.Trim"
             class="img-fluid rounded shadow-sm mb-4"
             style="max-height: 350px; object-fit: cover;" />
    }
<h2 class="h4 mt-4">Reviews</h2>
@if (Model.Reviews.Any())
{
    <div class="row row-cols-1 row-cols-md-2 g-3 mb-3">
    @foreach (var review in Model.Reviews)
    {
        <div class="col">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">@review.Rating / 5</h5>
                    <h6 class="card-subtitle mb-2 text-muted">@review.ReviewerName</h6>
                    <p class="card-text">@review.Comment</p>
                    <form asp-action="DeleteReview" method="post">
                        <input type="hidden" name="id" value="@review.Id" />
                        <input type="hidden" name="carId" value="@Model.Id" />
                        <button type="submit" class="btn btn-sm btn-danger">Delete Review</button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>
}
else
{
    <p>No reviews yet.</p>
}
<div class="text-center mb-3">
    <a asp-action="AddReview" asp-route-id="@Model.Id" class="btn btn-success">Add a Review</a>
</div>
<div class="row mb-3">
    <div class="col-6 text-center">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
    </div>
    <div class="col-6 text-center">
        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">Delete</a>
    </div>
</div>
<div class="text-center">
    <a asp-action="Index" class="btn btn-secondary">Back to Garage</a>
</div>
</div>